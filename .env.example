# Copier ce fichier sous le nom .env puis ajouter les secrets fournis par TFC PAY.
# Utiliser d'abord une clé sk_test_… dans le bac à sable.
TFC_API_BASE_URL=https://tcf-pay.infra.dongobada.com
TFC_API_KEY=
TFC_WEBHOOK_SECRET=
# Facultatif pendant la rotation du secret webhook : anciens secrets séparés par des virgules.
TFC_WEBHOOK_OLD_SECRETS=
FREESHOP_PORT=8787
